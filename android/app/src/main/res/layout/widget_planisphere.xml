<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#030817"
    android:contentDescription="@string/widget_description">

    <ImageView
        android:id="@+id/widget_chart"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:contentDescription="@string/widget_chart_description"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC030817"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/widget_loading"
        android:textColor="#C9D4E5"
        android:textSize="13sp" />
</FrameLayout>
