<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".PlanisphereWidgetProvider"
            android:label="@string/widget_name_large_visible_clock"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/planisphere_widget_info" />
        </receiver>
        <receiver android:name=".RocketChinaSquareLargeWidgetProvider" android:label="@string/widget_name_rocket_china_4x4" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_rocket_china_4x4" />
        </receiver>
        <receiver android:name=".RocketChinaSquareSmallWidgetProvider" android:label="@string/widget_name_rocket_china_2x2" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_rocket_china_2x2" />
        </receiver>
        <receiver android:name=".RocketChinaWideWidgetProvider" android:label="@string/widget_name_rocket_china_4x2" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_rocket_china_4x2" />
        </receiver>
        <receiver
            android:name=".SmallPlanisphereWidgetProvider"
            android:label="@string/widget_name_small_visible_clock"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/planisphere_widget_small_info" />
        </receiver>
        <receiver android:name=".LargeVisibleNoClockWidgetProvider" android:label="@string/widget_name_large_visible_no_clock" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_large_visible_no_clock" />
        </receiver>
        <receiver android:name=".LargeActiveClockWidgetProvider" android:label="@string/widget_name_large_active_clock" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_large_active_clock" />
        </receiver>
        <receiver android:name=".LargeActiveNoClockWidgetProvider" android:label="@string/widget_name_large_active_no_clock" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_large_active_no_clock" />
        </receiver>
        <receiver android:name=".SmallVisibleNoClockWidgetProvider" android:label="@string/widget_name_small_visible_no_clock" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_small_visible_no_clock" />
        </receiver>
        <receiver android:name=".SmallActiveClockWidgetProvider" android:label="@string/widget_name_small_active_clock" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_small_active_clock" />
        </receiver>
        <receiver android:name=".SmallActiveNoClockWidgetProvider" android:label="@string/widget_name_small_active_no_clock" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_small_active_no_clock" />
        </receiver>
        <receiver
            android:name=".PinWidgetReceiver"
            android:exported="false" />
        <service
            android:name=".WidgetRefreshJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver android:name=".RocketPinWidgetReceiver" android:exported="false" />
        <service
            android:name=".RocketWidgetRefreshJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
